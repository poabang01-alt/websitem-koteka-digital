# Copy the existing production APP_KEY; never generate a new key on redeployment.
APP_NAME="Koteka Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kotekadigital.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=sqlite
# Replace this with the existing database's absolute path outside public_html.
DB_DATABASE=/home/ACCOUNT/domains/DOMAIN/koteka/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
# Enable for a fresh deployment. Changing session encryption expires old sessions.
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Leave empty for direct TLS. Only list proxy IPs/CIDRs verified with your host.
# Never use * merely to make an HTTPS redirect loop disappear.
KOTEKA_TRUSTED_PROXIES=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@kotekadigital.com
MAIL_FROM_NAME="Koteka Digital"

# Retain the actual deployment's existing notification credentials privately.
RESEND_API_KEY=
KOTEKA_FROM_EMAIL=
KOTEKA_NOTIFY_EMAIL=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_TO=
META_WA_TEMPLATE_NAME=
META_WA_TEMPLATE_LANGUAGE=id
